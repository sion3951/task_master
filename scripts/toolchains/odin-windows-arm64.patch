diff --git a/base/runtime/procs_windows_arm64.odin b/base/runtime/procs_windows_arm64.odin
new file mode 100644
index 0000000..317f93f
--- /dev/null
+++ b/base/runtime/procs_windows_arm64.odin
@@ -0,0 +1,27 @@
+#+private
+#+no-instrumentation
+package runtime
+
+foreign import kernel32 "system:Kernel32.lib"
+
+@(private)
+foreign kernel32 {
+	RaiseException :: proc "system" (dwExceptionCode, dwExceptionFlags, nNumberOfArguments: u32, lpArguments: ^uint) -> ! ---
+}
+
+windows_trap_array_bounds :: proc "contextless" () -> ! {
+	EXCEPTION_ARRAY_BOUNDS_EXCEEDED :: 0xC000008C
+	when ODIN_CODEPAGE_MAGIC {
+		SetConsoleOutputCP(old_console_codepage)
+	}
+	RaiseException(EXCEPTION_ARRAY_BOUNDS_EXCEEDED, 0, 0, nil)
+}
+
+windows_trap_type_assertion :: proc "contextless" () -> ! {
+	windows_trap_array_bounds()
+}
+
+// Native ARM64 stack probing is provided by the MSVC runtime.
+when ODIN_NO_CRT {
+	#panic("Windows ARM64 currently requires the MSVC runtime; omit -no-crt.")
+}
diff --git a/core/sys/info/cpu_windows_arm64.odin b/core/sys/info/cpu_windows_arm64.odin
new file mode 100644
index 0000000..4f3dcf8
--- /dev/null
+++ b/core/sys/info/cpu_windows_arm64.odin
@@ -0,0 +1,18 @@
+package sysinfo
+
+foreign import kernel32 "system:kernel32.lib"
+
+foreign kernel32 {
+    IsProcessorFeaturePresent :: proc "system" (feature: u32) -> b32 ---
+}
+
+@(private)
+_cpu_features :: proc "contextless" () -> CPU_Features {
+    features: CPU_Features = {.asimd, .floatingpoint}
+    // Windows exposes supported instruction sets without reading privileged
+    // ARM identification registers. ARMv8 NEON/FP are mandatory on Windows.
+    if IsProcessorFeaturePresent(30) {features += {.aes, .pmull, .sha1, .sha256}}
+    if IsProcessorFeaturePresent(31) {features += {.crc32}}
+    if IsProcessorFeaturePresent(34) {features += {.lse}}
+    return features
+}
