#!/bin/sh
set -eu
fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "${3:-/}" = / ] || fail 'task_master must be installed on the running macOS system volume.'
directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
expected_architecture=$(cat "$directory/architecture")
[ "$(uname -m)" = "$expected_architecture" ] || fail "This task_master installer requires $expected_architecture; download the installer for this Mac's architecture."
os_major=$(sw_vers -productVersion | cut -d. -f1)
[ "$os_major" -ge 13 ] || fail 'task_master requires macOS 13 or newer.'
[ ! -L /Applications/task_master.app ] || fail 'Refusing a symlink at /Applications/task_master.app.'
